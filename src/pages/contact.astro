---
import Page from '../layouts/Page.astro';
import site from '../site.config.ts';
---
<Page title="Contact" description={`Contact ${site.name}.`}>
  <p>Found a bug, a wrong answer, or a lift or option we should add? Send us an email and we will read it.</p>
  <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
  <p>Please include your device, your browser and the numbers you entered. That helps us find the problem fast.</p>
</Page>
